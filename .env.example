# 默认 Compose 只启动 LightMoni，连接已部署的 ClickHouse。
# 复制为 .env，填写数据库连接与密码后运行 docker compose up -d --build --wait。
COMPOSE_PROJECT_NAME=lightmoni

# 源码构建时生成的镜像标签；使用已发布镜像时改为对应仓库地址与固定版本。
LIGHTMONI_IMAGE=lightmoni:0.1.0
LIGHTMONI_BIND_ADDRESS=0.0.0.0
LIGHTMONI_PORT=8080

# 用户访问的完整工作台地址；使用 Nginx 时填写 HTTPS 域名。
# SDK / Agent 的默认中心上报地址初始使用此值，也可在系统设置中单独配置。
LIGHTMONI_EXTERNAL_URL=http://localhost:8080

# ClickHouse HTTP(S) 接口，而非原生 TCP 9000 端口。
# 宿主机数据库可使用 host.docker.internal；远程数据库改为其域名或 IP。
LIGHTMONI_CH_URL=http://host.docker.internal:8123
LIGHTMONI_CH_USER=lightmoni
# 必填。账号需支持建库、建表、写入、创建只读查询用户和授权。
# 密码包含 $ 或 # 时，用单引号包裹整个值，避免 .env 插值或注释。
LIGHTMONI_CH_PASSWORD=

# 可选的中心 AI 代码任务能力（默认关闭）。请使用专用源码目录，不要指向生产或数据目录。
# Node 本地启动时传入以下环境变量；Compose 需另在 override 中挂载工作区并传入变量。
# LIGHTMONI_CODE_WORKSPACE=/srv/lightmoni-code-workspaces
# 检查命令默认 []，只有信任的源码和完整命令才应开放。临时副本不是 OS 沙箱。
# LIGHTMONI_CODE_CHECK_COMMANDS='["node --check app.js"]'
