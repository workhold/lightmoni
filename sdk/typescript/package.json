{
  "name": "@lightmoni/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Bounded OTLP/HTTP telemetry for LightMoni",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workhold/lightmoni.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/workhold/lightmoni/tree/main/sdk/typescript",
  "bugs": "https://github.com/workhold/lightmoni/issues",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md",
    "examples/record.mjs"
