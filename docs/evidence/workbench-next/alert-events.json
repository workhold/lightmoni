  "rules": [
    {
      "kind": "metric",
      "id": "46d4af60f62a2f963f0d71736bd158c1",
      "name": "本机 CPU · 告警标记验收",
      "enabled": true,
      "revision": 3,
      "sql": "SELECT\n  `series`,\n  avg(`value`) AS value\nFROM (\nSELECT $__timeInterval(event_time) AS time, host_id AS series, avg(value) AS value FROM metric_host_gauge WHERE $__timeFilter(event_time) AND name='host.cpu.utilization' GROUP BY time,series ORDER BY time\n)\nGROUP BY `series`",
      "source_table_ids": [
        "metric_host_gauge"
      ],
      "services": [],
      "value_field": "value",
      "label_fields": [
        "series"
      ],
      "operator": "gt",
      "threshold": "0.2",
      "interval_seconds": 10,
      "window_seconds": 30,
      "delay_seconds": 0,
      "for_seconds": 0,
      "recovery_seconds": 0,
      "repeat_seconds": 0,
      "health_for_seconds": 60,
