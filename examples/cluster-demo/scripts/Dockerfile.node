FROM m.daocloud.io/docker.io/library/node:24.15.0-alpine AS node
FROM m.daocloud.io/docker.io/library/docker:27.5.1-dind
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/lib/libstdc++.so.6* /usr/lib/libgcc_s.so.1 /usr/lib/
COPY node-entrypoint.sh /usr/local/bin/demo-node-entrypoint
ENTRYPOINT ["dind", "sh", "/usr/local/bin/demo-node-entrypoint"]
