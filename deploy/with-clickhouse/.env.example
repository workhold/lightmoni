# 此目录的 Compose 同时启动 LightMoni 和 ClickHouse。
# 在此目录复制为 .env，填写密码后运行 docker compose up -d --build --wait。
COMPOSE_PROJECT_NAME=lightmoni

LIGHTMONI_IMAGE=lightmoni:0.1.0
LIGHTMONI_BIND_ADDRESS=0.0.0.0
LIGHTMONI_PORT=8080
LIGHTMONI_EXTERNAL_URL=http://localhost:8080

# 主服务与随附 ClickHouse 共用此连接账号；数据库端口不向宿主机开放。
LIGHTMONI_CH_URL=http://clickhouse:8123
LIGHTMONI_CH_USER=lightmoni
# 必填，可用 openssl rand -hex 24 生成。
# 密码包含 $ 或 # 时，用单引号包裹整个值。
LIGHTMONI_CH_PASSWORD=
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8

GOPROXY=https://proxy.golang.org,direct
