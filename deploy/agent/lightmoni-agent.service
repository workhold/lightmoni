[Unit]
Description=LightMoni Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightmoni-agent
Group=lightmoni-agent
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SupplementaryGroups=
AmbientCapabilities=
CapabilityBoundingSet=
ExecStartPre=/opt/lightmoni-agent/current/node /opt/lightmoni-agent/current/deployment-permissions.mjs check
ExecStart=/usr/local/bin/lightmoni-agent run --config /etc/lightmoni-agent/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/lightmoni-agent
UMask=0077

[Install]
WantedBy=multi-user.target
